{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "TEMPLATE for real client repos consuming pod-test-* packages. Copy this file to your repo root and adjust the schedule/auto-merge rules to your team's taste.",
  "packageRules": [
    {
      "description": "POD Design System packages — group + frequent",
      "matchPackageNames": [
        "pod-test-ui",
        "pod-test-tokens"
      ],
      "groupName": "POD Design System",
      "schedule": ["before 9am on monday"],
      "labels": ["pod-design-system", "automated"],
      "commitMessagePrefix": "deps(pod):",
      "automerge": false,
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge patch updates from pod-* if CI passes",
      "matchPackageNames": [
        "pod-test-ui",
        "pod-test-tokens"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
