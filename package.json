{
  "name": "pod-design-system-test",
  "private": true,
  "version": "0.1.2",
  "description": "Small design system test environment for POD — sprint-style scope.",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "pnpm -F docs dev",
    "build": "pnpm -F docs build",
    "typecheck": "pnpm -r --parallel typecheck",
    "clean": "rm -rf node_modules **/node_modules **/dist",
    "figma:check": "node scripts/figma/check.mjs",
    "figma:bless": "node scripts/figma/bless.mjs",
    "figma:discover": "node scripts/figma/discover.mjs",
    "figma:status": "node scripts/figma/check.mjs --json > apps/docs/public/figma-status.json 2>/dev/null || echo '{\"drifted\":[],\"inSync\":[],\"errors\":[]}' > apps/docs/public/figma-status.json"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
