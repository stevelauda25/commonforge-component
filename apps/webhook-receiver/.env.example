# Copy to Vercel project env vars (this file is for reference only).
# All values are required at runtime.

# Figma webhook v2 shared secret (passcode).
# Set this when creating the webhook via Figma REST API.
# The webhook delivers the passcode in the request body; we compare timing-safe.
FIGMA_WEBHOOK_SECRET=

# GitHub App credentials — used to dispatch repository_dispatch events.
# Create the App at: https://github.com/settings/apps/new
# Required permissions: Contents (R/W), Pull requests (R/W), Metadata (R)
# After install, grab installation ID from the install URL.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Paste the entire PEM contents (with newlines) — Vercel UI accepts multi-line.
GITHUB_APP_PRIVATE_KEY=

# Target repo in owner/repo format. The repository_dispatch lands here.
GITHUB_REPO=stevelauda25/pod-native-design-system
