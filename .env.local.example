# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Figma Personal Access Token
# Generate at: https://www.figma.com/settings → Personal access tokens
# Required scopes: file_content:read, library_content:read, file_variables:read
FIGMA_PAT=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The canonical CF Design System file key.
# Extract from URL: https://figma.com/design/<FILE_KEY>/<file-name>
FIGMA_FILE_KEY=TCd9exLXTUMciyw1VqnPSK
