{
  "name": "@commonforge/tokens",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/tailwind-preset.ts --format cjs,esm --dts --clean && cp src/theme.css dist/theme.css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
