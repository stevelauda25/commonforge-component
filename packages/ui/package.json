{
  "name": "pod-test-ui",
  "version": "0.1.4",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.mjs",
      "require": "./dist/checkbox.js"
    },
    "./search-input": {
      "types": "./dist/search-input.d.ts",
      "import": "./dist/search-input.mjs",
      "require": "./dist/search-input.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.mjs",
      "require": "./dist/switch.js"
    },
    "./text-input": {
      "types": "./dist/text-input.d.ts",
      "import": "./dist/text-input.mjs",
      "require": "./dist/text-input.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.mjs",
      "require": "./dist/tooltip.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.mjs",
      "require": "./dist/canvas.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "npm run canvas:sync && tsup && npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.ts -i styles/build.css -o dist/styles.css --minify",
    "canvas:sync": "node ../../scripts/canvas/sync.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.428.0",
    "pod-test-tokens": "0.1.3",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3"
  }
}
